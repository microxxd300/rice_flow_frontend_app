# Backend API URL. Leave it commented out to use the default ngrok tunnel
# (https://doing-haven-requisite.ngrok-free.dev/api).
# On a phone, use the ngrok URL or your PC's LAN IP (http://192.168.x.x:8000/api), never localhost.
# Restart Expo with `npx expo start -c` after changing it.
# EXPO_PUBLIC_API_URL=https://doing-haven-requisite.ngrok-free.dev/api

EXPO_PUBLIC_ENV=development
