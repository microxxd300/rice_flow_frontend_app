{
  "expo": {
    "name": "rice-flow",
    "slug": "rice-flow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.riceflow.app"
    },
    "android": {
      "package": "com.riceflow.app",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon/adaptive-icon.png",
        "backgroundColor": "#111827"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RiceFlow uses your location to put your farm on the map and recommend rice varieties for it."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/icon/adaptive-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F1F2F1"
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "icon": "./src/assets/icon/icon.png"
  }
}
